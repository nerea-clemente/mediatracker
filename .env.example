# Copy to .env and fill in. .env is gitignored.

# Anthropic (used in Phase 2+)
ANTHROPIC_API_KEY=sk-ant-...

# SQLite path. Default is data/mediatracker.db relative to repo root.
MEDIATRACKER_DB=data/mediatracker.db

# HTTP fetcher
MEDIATRACKER_USER_AGENT=mediatracker/0.1 (+https://example.invalid)
MEDIATRACKER_HTTP_TIMEOUT=20

# Email (Phase 5 — leave blank for now)
# RESEND_API_KEY=
# REPORT_FROM=
# REPORT_TO=
